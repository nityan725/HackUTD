# Copy this file to ".env.local" and fill in your values.

# --- Capital One Nessie ---
NESSIE_API_KEY=paste_your_key_here
NESSIE_CUSTOMER_ID=d852d265-af21-4b3d-9747-c210c930d3a0
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
# Set to 1 to force the built-in demo data (e.g. if the wifi dies during judging)
NESSIE_MOCK=0

# --- Demo date ---
# Carrie's data was created on Nov 7, 2026. Pinning "today" to that date makes the
# app show her cash crunch every time. Delete this line to use the real date.
NEXT_PUBLIC_DEMO_TODAY=2026-11-07
NEXT_PUBLIC_BALANCE_AS_OF=2026-11-07

# --- Sign-in ---
# Any long random phrase. Signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-phrase
